<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jaycong</groupId>
        <artifactId>jaycong-boot-framework</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>jaycong-admin</artifactId>
    <name>JayCong Admin</name>
    <description>管理端服务入口，接入 Nacos、OpenFeign 和 Sa-Token</description>
    <dependencies>
        <dependency>
            <groupId>io.github.jaycong</groupId>
            <artifactId>jaycong-common-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jaycong</groupId>
            <artifactId>jaycong-common-config</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jaycong</groupId>
            <artifactId>jaycong-common-satoken</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jaycong</groupId>
            <artifactId>jaycong-common-rpc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.jaycong</groupId>
            <artifactId>jaycong-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution><goals><goal>repackage</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
